include README.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md .env.example .gitignore .gitattributes .editorconfig
recursive-include docs *.md *.json
recursive-include examples *.csv *.json
recursive-include schemas *.json
recursive-include tests *.py
recursive-include tools *.py
recursive-include constraints *.txt
recursive-include .github *.yml
global-exclude *.pyc *.pyo
prune .venv
prune runs
prune dist
